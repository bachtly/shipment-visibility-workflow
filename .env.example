# Copy to .env and fill in values

# Postgres — used for both DBOS system tables and app tables
DBOS_SYSTEM_DATABASE_URL=postgresql+psycopg://shipvis:shipvis@localhost:5433/shipvis
DATABASE_URL=postgresql+psycopg://shipvis:shipvis@localhost:5433/shipvis

# DBOS Conductor (managed) — from README
DBOS_CONDUCTOR_KEY=
