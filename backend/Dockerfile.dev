FROM python:3.12-slim
WORKDIR /app

# Install runtime + dev deps without installing the local package itself.
# PYTHONPATH=/app lets Python import 'app.*' from the volume-mounted source.
RUN pip install --no-cache-dir \
    "dbos==2.23.0" \
    "fastapi>=0.115" \
    "uvicorn[standard]>=0.30" \
    "psycopg[binary]>=3.2" \
    "sqlalchemy>=2.0" \
    "pydantic>=2.0" \
    "python-dotenv>=1.0" \
    "sse-starlette>=2.0" \
    "pytest>=8" \
    "pytest-asyncio>=0.24" \
    "httpx>=0.27"

COPY backend/app ./app
ENV PYTHONPATH=/app
EXPOSE 8080
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080", "--reload"]
